{
    "name": "sveltekit-template",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "imports": {
        "#lib": "./src/lib/index.js",
        "#lib/*": "./src/lib/*"
    },
    "scripts": {
        "dev": "vp dev",
        "build": "vp build",
        "preview": "vp preview",
        "prepare": "vp config && svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch"
    },
    "dependencies": {
        "@lucide/svelte": "^1.57.0",
        "@supabase/supabase-js": "^2.118.0",
        "@tailwindcss/vite": "^4.3.3",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/space-grotesk": "^5.3.0",
        "@neoconfetti/svelte": "^2.2.2",
        "@sveltejs/adapter-auto": "^8.0.0",
        "@sveltejs/adapter-vercel": "^7.0.1",
        "@sveltejs/kit": "^3.1.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "oxfmt": "^0.61.0",
        "oxlint": "^1.88.0",
        "supabase": "^2.121.0",
        "svelte": "^5.57.2",
        "svelte-check": "^4.7.6",
        "typescript": "^6.0.3",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5",
        "vite-plus": "catalog:",
        "zod": "^4.6.7"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "11.18.0",
            "onFail": "download"
        }
    },
    "engines": {
        "node": "=24.22.0",
        "pnpm": "=11.18.0"
    }
}
